{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "types": ["mocha", "node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "tests/**/*"]
}
