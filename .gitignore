node_modules/
dist/
outputs/*.json
# `npm run verify` writes THIS RUN's results here and never into the committed paths (D1).
# It is a run record, not audit evidence.
outputs/run/
!outputs/.gitkeep
!outputs/verification-results.json
!outputs/simulation-results.json
!outputs/calibration-results.json
!outputs/coverage-results.json
!outputs/verification-stats.json
outputs/*.log
# A fresh experiment (`npm run simulate`) writes here so it can never overwrite
# the artifact of record in outputs/. It is a NEW experiment, not audit evidence.
outputs/fresh/
!outputs/rtp-claim-table.json
